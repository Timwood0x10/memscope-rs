    // Render task timeline rows
    (function renderTaskTimeline() {
        const rows = document.getElementById('taskTimelineRows');
        if (!rows) return;
        const tasks = DATA.async_tasks || [];
        if (tasks.length === 0) { rows.innerHTML = '<div class="text-outline text-xs">No async tasks.</div>'; return; }
        const start = Math.min(...tasks.map(t => t.created_at_ms));
        const cut = DATA.allocation_lifetimes.capture_at_ns / 1e6;
        const end = Math.max(cut, ...tasks.map(t => t.completed_at_ms ?? t.created_at_ms));
        const span = Math.max(1, end - start);
        tasks.slice(0, 10).forEach((t, idx) => {
            const complete = t.completed_at_ms != null && t.completed_at_ms >= t.created_at_ms;
            const duration = complete ? (t.completed_at_ms - t.created_at_ms) + 'ms' : 'Unknown (not completed)';
            const left = Math.max(0, (t.created_at_ms - start) / span * 100);
            const width = Math.max(0, ((complete ? t.completed_at_ms : cut) - t.created_at_ms) / span * 100);
            const row = document.createElement('div');
            row.className = 'flex items-center gap-3 font-data-mono text-xs chart-interactive';
            row.style.cursor = 'pointer';
            row.innerHTML = `<span class="text-accent-amber w-16">${t.task_id}</span><span class="text-on-surface w-32 truncate">${t.task_name || ''}</span><div class="relative flex-1 h-2 bg-surface-container-highest rounded-full overflow-hidden"><div class="absolute h-full bg-primary" style="left:${left}%;width:${width}%;opacity:${complete ? 1 : 0.4}"></div></div><span class="text-secondary text-right">${duration}</span>`;
            bindInteractive(row, 'TASK_TIMELINE_' + idx, [
                ['task_id', t.task_id != null ? t.task_id : '?'],
                ['name', t.task_name || '—'],
                ['type', t.task_type || '—'],
                ['completed duration', duration],
                ['created_at_ms', t.created_at_ms],
                ['completed_at_ms', t.completed_at_ms ?? 'Unknown'],
                ['allocations', t.total_allocations != null ? t.total_allocations : '?'],
                ['current_mem', (t.current_memory != null ? t.current_memory : '?') + 'B'],
                ['peak_mem', (t.peak_memory != null ? t.peak_memory : '?') + 'B'],
                ['status', t.status || '—'],
                ['leak', t.has_potential_leak ? 'YES ⚠' : 'no']
            ], 'TASK_DURATION', (t.task_name || '?') + ' · ' + duration + ' · ' + (t.status || '?'));
            rows.appendChild(row);
        });
    })();

